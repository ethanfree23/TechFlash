# Checkr Background Check Configuration
# Copy this file to .env and configure the values

# Enable/disable Checkr integration
CHECKR_ENABLED=true
CHECKR_BACKGROUND_CHECKS_ENABLED=true

# Demo bypass mode - set to true for local development without Checkr API credentials
# This allows testing the background check flow without connecting to Checkr's API
CHECKR_DEMO_BYPASS=true

# Checkr environment (staging or production)
CHECKR_ENVIRONMENT=staging

# Checkr API credentials (required when CHECKR_DEMO_BYPASS=false)
# Get these from your Checkr dashboard at https://dashboard.checkr.com
# CHECKR_SECRET_KEY=your_checkr_api_key_here
# CHECKR_WEBHOOK_SECRET=your_webhook_secret_here
# CHECKR_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/checkr

# Checkr API base URL (usually don't need to change this)
CHECKR_API_BASE_URL=https://api.checkr.com

# Default package slug for background checks
# Common values: essential, basic, standard, premium
# Check your Checkr dashboard for available packages
CHECKR_DEFAULT_PACKAGE=essential

# Production mode (only set to true when using production Checkr account)
CHECKR_PRODUCTION_ENABLED=false

# Optional: Default node custom ID (for multi-location organizations)
# CHECKR_DEFAULT_NODE_CUSTOM_ID=

# Other common environment variables
# DATABASE_URL=
# FRONTEND_URL=http://localhost:5173
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
